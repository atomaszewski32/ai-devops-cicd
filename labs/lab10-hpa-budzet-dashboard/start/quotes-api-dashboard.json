{
  "title": "quotes-api",
  "uid": "quotes-api",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "timezone": "browser",
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "30s",
  "tags": ["quotes-api", "szkolenie"],

  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      },
      {
        "name": "namespace",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": "label_values(quotes_requests_total, namespace)",
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "current": {}
      }
    ]
  },

  "panels": [
    {
      "id": 1,
      "title": "Żądania na sekundę wg wersji (stable / canary)",
      "description": "Etykieta `version` w quotes_requests_total to APP_VERSION obrazu (v1 = stable, v2 = canary w tym repo) — nie mylić z etykietą `wersja` (hash ReplicaSetu canary) używaną przez AnalysisTemplate.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "spanNulls": true }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (version) (rate(quotes_requests_total{namespace=\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "{{version}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Czas odpowiedzi p95",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "spanNulls": true }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, endpoint) (rate(quotes_request_seconds_bucket{namespace=\"$namespace\"}[$__rate_interval])))",
          "legendFormat": "{{endpoint}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Odsetek odpowiedzi 5xx",
      "description": "Ten sam próg (5%), jaki AnalysisTemplate `odsetek-bledow` używa jako successCondition dla canary.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "spanNulls": true,
            "thresholdsStyle": { "mode": "line" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 5 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (sum(rate(quotes_requests_total{namespace=\"$namespace\", status=~\"5..\"}[$__rate_interval])) or vector(0)) / sum(rate(quotes_requests_total{namespace=\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "odsetek 5xx"
        }
      ]
    },
    {
      "id": 4,
      "title": "Liczba replik w czasie (progi HPA)",
      "description": "quotes-api to Rollout (Argo Rollouts), nie Deployment, więc kube_deployment_status_replicas nie ma dla niego danych (kube-state-metrics wystawia tę metrykę tylko dla obiektów Deployment) — panel liczy gotowe pody po nazwie zamiast tego. Progi 2/8 odpowiadają app/k8s/hpa.yaml — podmień na wartości aktualnie zaaplikowanego HPA (np. 2/10 w Etapie 2 tego labu).",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 5,
            "spanNulls": true,
            "thresholdsStyle": { "mode": "dashed" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 2 },
              { "color": "red", "value": 8 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kube_pod_status_ready{namespace=\"$namespace\", condition=\"true\", pod=~\"quotes-api-.*\"})",
          "legendFormat": "repliki gotowe"
        }
      ]
    }
  ]
}
